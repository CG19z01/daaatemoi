# Copier ce fichier vers .env puis remplacer par de vraies valeurs.
PORT=3000

# Secret de signature des cookies (32 octets aleatoires, exemple factice)
SECRET_SIGNATURE=exemple_de_secret_a_remplacer_0000000000000000

# Identifiants de la page d'administration (exemple factice)
ADMIN_IDENTIFIANT=admin
ADMIN_MOT_DE_PASSE=exemple_de_mot_de_passe_a_remplacer


# Stockage partage, obligatoire en deploiement (injecte automatiquement par
# l'integration Upstash du Marketplace Vercel). Absent en local : le projet
# retombe sur les fichiers JSON de donnees/.
UPSTASH_REDIS_REST_URL=https://exemple-a-remplacer.upstash.io
UPSTASH_REDIS_REST_TOKEN=jeton_a_remplacer

# Notification d'un nouveau rendez-vous via ntfy (facultative : sans elle le site
# fonctionne, sans prevenir). Aucun compte n'est necessaire : le sujet fait office
# de secret, il doit donc etre long et impossible a deviner.
# Il reste cote serveur et n'est jamais envoye au navigateur.
NTFY_SUJET=sujet-long-et-impossible-a-deviner
# Facultatif : une autre instance ntfy que la publique.
NTFY_ADRESSE=https://ntfy.sh
# Facultatif : uniquement si l'instance ntfy exige une authentification.
NTFY_JETON=

# --- Plateforme d'experiences (page /create) ---

# Adresse publique du site, utilisee pour composer le lien partage.
# Sur Vercel, VERCEL_PROJECT_PRODUCTION_URL suffit : cette variable n'est utile
# qu'en dehors. A defaut, le serveur deduit l'adresse de la requete en cours.
SITE_ADRESSE_PUBLIQUE=https://daaatemoi.vercel.app

# Cartographie OpenStreetMap : ni compte, ni cle API, donc aucun secret.
# Les services OSM demandent seulement que l'appelant s'identifie clairement.
# Remplacer par une adresse de contact reelle avant une mise en ligne.
OSM_AGENT=daaatemoi/1.0 (contact@exemple.fr)

# Facultatif : instances a interroger. Les valeurs par defaut conviennent.
NOMINATIM_ADRESSE=https://nominatim.openstreetmap.org
OVERPASS_ADRESSES=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
